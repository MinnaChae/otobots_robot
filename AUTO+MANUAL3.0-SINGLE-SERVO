# ============================================================
# XRP ROBOT - COMPLETE MANUAL AND AUTONOMOUS PROGRAM
#
# MANUAL DRIVE:
# RT              = Drive forward
# LT              = Drive backward
# Right joystick  = Steering
#
# SERVO 1:
# Hold X          = Rotate one direction
# Hold B          = Rotate opposite direction
# Release X/B     = Stop Servo1
#
# AUTONOMY:
# D-pad Down      = Start maze autonomy
# D-pad Up        = Start blue-line autonomy
# D-pad Left      = Immediate manual override
#
# RT, LT, or joystick movement also cancels autonomy.
# ============================================================

from XRPLib.defaults import *
from pestolink import PestoLinkAgent
import time


# ============================================================
# PESTOLINK
# ============================================================

pestolink = PestoLinkAgent("OCHOBOTS")


# ============================================================
# CONTROLLER BUTTONS
# ============================================================

BUTTON_B = 1
BUTTON_X = 2

BUTTON_LT = 6
BUTTON_RT = 7

BUTTON_DPAD_UP = 12
BUTTON_DPAD_DOWN = 13
BUTTON_DPAD_LEFT = 14

RIGHT_STICK_X = 2


# ============================================================
# ROBOT MODES
# ============================================================

MODE_MANUAL = 0
MODE_MAZE = 1
MODE_LINE = 2


# ============================================================
# MANUAL DRIVE SETTINGS
# ============================================================

MANUAL_DRIVE_POWER = 0.75
MANUAL_TURN_POWER = 0.55

JOYSTICK_DEADZONE = 0.12


# ============================================================
# SERVO 1 CONTINUOUS-ROTATION SETTINGS
#
# Hold X = rotate one direction
# Hold B = rotate opposite direction
# Release = stop
#
# These values match the Servo1 mapping from your earlier
# working XRP setup:
#
# 90  = one direction
# 180 = stop
# 0   = opposite direction
#
# If X and B run backward, swap SERVO_X_COMMAND and
# SERVO_B_COMMAND.
# ============================================================

SERVO_X_COMMAND = 90
SERVO_STOP_COMMAND = 180
SERVO_B_COMMAND = 0


# ============================================================
# MAZE SETTINGS
# ============================================================

INCHES_TO_CM = 2.54

MAZE_DRIVE_POWER = 0.65
MAZE_TURN_POWER = 0.55

LEFT_TURN_SIGN = -1
RIGHT_TURN_SIGN = 1

# Small chunks make D-pad Left more responsive.
MAZE_DISTANCE_CHUNK_INCHES = 2
MAZE_TURN_CHUNK_DEGREES = 15

MAZE_STEP_PAUSE = 0.10


# ============================================================
# PREPROGRAMMED MAZE ROUTE
# ============================================================

MAZE_ROUTE = [
    ("forward", 12),
    ("forward", 12),

    ("right", 90),

    ("forward", 9),
    ("forward", 9),

    ("left", 90),

    ("forward", 10),
    ("forward", 10),
    ("forward", 10),

    ("right", 90),

    ("forward", 12)
]


# ============================================================
# SENSOR 1: BLUE LINE ON BLACK FLOOR
#
# Sensor 1 is treated as the LEFT reflectance sensor.
#
# It follows one edge of the blue tape.
#
# Replace these example numbers with your measured readings.
# ============================================================

BLACK_FLOOR_READING = 0.85
BLUE_TAPE_READING = 0.45

MIN_SENSOR_DIFFERENCE = 0.04

LINE_EDGE_TARGET = (
    BLACK_FLOOR_READING
    + BLUE_TAPE_READING
) / 2.0


# ============================================================
# BLUE-LINE SETTINGS
#
# Only small steering corrections are allowed.
# Neither wheel reverses during line following.
# ============================================================

LINE_BASE_POWER = 0.14
LINE_MIN_WHEEL_POWER = 0.05

LINE_KP = 0.22
LINE_KD = 0.04

LINE_MAX_CORRECTION = 0.07

LINE_MAX_TIME_SECONDS = 50.0
LINE_LOST_STOP_SECONDS = 0.40

# Change to -1 if the robot steers away from the tape.
LINE_STEERING_SIGN = 1


# ============================================================
# SENSOR 2: DISTANCE SENSOR
#
# Leave this disabled until manual, maze, and line movement
# are confirmed working.
#
# An incorrect distance-sensor command will therefore not stop
# the whole robot.
# ============================================================

USE_DISTANCE_SENSOR = False

OBSTACLE_STOP_DISTANCE_CM = 10.0


# ============================================================
# ROBOT STATE
# ============================================================

state = {
    "mode": MODE_MANUAL,

    "maze_step": 0,
    "maze_running": False,

    "line_start_time": time.ticks_ms(),
    "line_lost_start": None,
    "previous_line_error": 0.0,

    "previous_up": False,
    "previous_down": False,
    "previous_left": False
}


# ============================================================
# BASIC HELPERS
# ============================================================

def limit(value, minimum=-1.0, maximum=1.0):
    if value > maximum:
        return maximum

    if value < minimum:
        return minimum

    return value


def apply_deadzone(value):
    if abs(value) < JOYSTICK_DEADZONE:
        return 0.0

    return value


def elapsed_seconds(start_time):
    return time.ticks_diff(
        time.ticks_ms(),
        start_time
    ) / 1000.0


def stop_drive():
    drivetrain.stop()


def stop_servo():
    servo_one.set_angle(
        SERVO_STOP_COMMAND
    )


def stop_everything():
    stop_drive()
    stop_servo()


# ============================================================
# CONTROLLER HELPERS
# ============================================================

def dpad_left_pressed():
    return pestolink.get_button(
        BUTTON_DPAD_LEFT
    )


def manual_drive_input_detected():
    if pestolink.get_button(BUTTON_RT):
        return True

    if pestolink.get_button(BUTTON_LT):
        return True

    steering = pestolink.get_axis(
        RIGHT_STICK_X
    )

    steering = apply_deadzone(steering)

    return steering != 0.0


def cancel_autonomy_requested():
    if dpad_left_pressed():
        return True

    if manual_drive_input_detected():
        return True

    return False


# ============================================================
# MODE FUNCTIONS
# ============================================================

def enter_manual_mode():
    stop_drive()

    state["mode"] = MODE_MANUAL
    state["maze_running"] = False


def enter_maze_mode():
    stop_drive()

    state["mode"] = MODE_MAZE
    state["maze_step"] = 0
    state["maze_running"] = True

    print("MAZE MODE STARTED")


def enter_line_mode():
    stop_drive()

    state["mode"] = MODE_LINE

    state["line_start_time"] = time.ticks_ms()
    state["line_lost_start"] = None
    state["previous_line_error"] = 0.0

    print("LINE MODE STARTED")


# ============================================================
# SERVO 1 CONTROL
#
# Servo1 responds only while the button is held.
#
# X and B pressed together:
# Servo1 stops for safety.
# ============================================================

def control_servo_one():
    x_pressed = pestolink.get_button(
        BUTTON_X
    )

    b_pressed = pestolink.get_button(
        BUTTON_B
    )

    # Both pressed: stop for safety.
    if x_pressed and b_pressed:
        servo_one.set_angle(
            SERVO_STOP_COMMAND
        )

    # Hold X: rotate one direction.
    elif x_pressed:
        servo_one.set_angle(
            SERVO_X_COMMAND
        )

    # Hold B: rotate the opposite direction.
    elif b_pressed:
        servo_one.set_angle(
            SERVO_B_COMMAND
        )

    # Release both buttons: stop.
    else:
        servo_one.set_angle(
            SERVO_STOP_COMMAND
        )


# ============================================================
# MANUAL DRIVE
# ============================================================

def manual_control():
    throttle = 0.0

    if pestolink.get_button(BUTTON_RT):
        throttle = MANUAL_DRIVE_POWER

    elif pestolink.get_button(BUTTON_LT):
        throttle = -MANUAL_DRIVE_POWER

    steering = pestolink.get_axis(
        RIGHT_STICK_X
    )

    steering = apply_deadzone(steering)
    steering = steering * MANUAL_TURN_POWER

    left_power = throttle + steering
    right_power = throttle - steering

    drivetrain.set_effort(
        limit(left_power),
        limit(right_power)
    )

    control_servo_one()


# ============================================================
# INTERRUPTIBLE MAZE MOVEMENT
# ============================================================

def drive_inches(distance_inches, forward=True):
    remaining = abs(distance_inches)

    while remaining > 0:
        control_servo_one()

        if cancel_autonomy_requested():
            enter_manual_mode()
            return False

        chunk = min(
            MAZE_DISTANCE_CHUNK_INCHES,
            remaining
        )

        distance_cm = chunk * INCHES_TO_CM

        if not forward:
            distance_cm = -distance_cm

        drivetrain.straight(
            distance_cm,
            MAZE_DRIVE_POWER
        )

        remaining -= chunk

        time.sleep(0.02)

    return True


def turn_degrees(degrees, turn_sign):
    remaining = abs(degrees)

    while remaining > 0:
        control_servo_one()

        if cancel_autonomy_requested():
            enter_manual_mode()
            return False

        chunk = min(
            MAZE_TURN_CHUNK_DEGREES,
            remaining
        )

        drivetrain.turn(
            chunk * turn_sign,
            MAZE_TURN_POWER
        )

        remaining -= chunk

        time.sleep(0.02)

    return True


def wait_interruptible(wait_seconds):
    wait_start = time.ticks_ms()

    while elapsed_seconds(wait_start) < wait_seconds:
        control_servo_one()

        if cancel_autonomy_requested():
            enter_manual_mode()
            return False

        time.sleep(0.02)

    return True


def perform_maze_step(action, amount):
    if action == "forward":
        return drive_inches(
            amount,
            True
        )

    elif action == "reverse":
        return drive_inches(
            amount,
            False
        )

    elif action == "left":
        return turn_degrees(
            amount,
            LEFT_TURN_SIGN
        )

    elif action == "right":
        return turn_degrees(
            amount,
            RIGHT_TURN_SIGN
        )

    elif action == "wait":
        return wait_interruptible(
            amount
        )

    return False


# ============================================================
# MAZE AUTONOMY
# ============================================================

def maze_control():
    control_servo_one()

    if cancel_autonomy_requested():
        enter_manual_mode()
        return

    if not state["maze_running"]:
        enter_manual_mode()
        return

    if state["maze_step"] >= len(MAZE_ROUTE):
        print("MAZE COMPLETE")

        stop_drive()

        state["maze_running"] = False
        state["mode"] = MODE_MANUAL

        return

    action, amount = MAZE_ROUTE[
        state["maze_step"]
    ]

    completed = perform_maze_step(
        action,
        amount
    )

    if completed:
        state["maze_step"] += 1

        stop_drive()
        time.sleep(MAZE_STEP_PAUSE)

    else:
        enter_manual_mode()


# ============================================================
# SENSOR 1: LINE SENSOR
# ============================================================

def read_line_sensor():
    try:
        return reflectance.get_left()

    except Exception as error:
        print("LINE SENSOR ERROR:")
        print(error)

        return None


# ============================================================
# SENSOR 2: DISTANCE SENSOR
# ============================================================

def read_distance_sensor():
    if not USE_DISTANCE_SENSOR:
        return None

    try:
        return rangefinder.distance()

    except Exception as error:
        print("DISTANCE SENSOR ERROR:")
        print(error)

        return None


def obstacle_detected():
    distance = read_distance_sensor()

    if distance is None:
        return False

    if distance <= 0:
        return False

    return (
        distance
        < OBSTACLE_STOP_DISTANCE_CM
    )


# ============================================================
# SINGLE-SENSOR BLUE-LINE FOLLOWING
#
# Sensor 1 follows one edge of the blue tape.
#
# The robot makes only small steering corrections.
# Neither wheel reverses.
# ============================================================

def line_control():
    control_servo_one()

    if cancel_autonomy_requested():
        enter_manual_mode()
        return

    if obstacle_detected():
        print("OBSTACLE DETECTED")

        enter_manual_mode()
        return

    if elapsed_seconds(
        state["line_start_time"]
    ) >= LINE_MAX_TIME_SECONDS:
        print("LINE MODE TIMEOUT")

        enter_manual_mode()
        return

    difference = (
        BLUE_TAPE_READING
        - BLACK_FLOOR_READING
    )

    if abs(difference) < MIN_SENSOR_DIFFERENCE:
        print("BAD LINE CALIBRATION")

        enter_manual_mode()
        return

    sensor_value = read_line_sensor()

    if sensor_value is None:
        enter_manual_mode()
        return

    line_error = (
        sensor_value
        - LINE_EDGE_TARGET
    ) / difference

    line_error = (
        line_error
        * LINE_STEERING_SIGN
    )

    # Sensor is far outside the expected tape-edge range.
    if abs(line_error) > 1.25:
        if state["line_lost_start"] is None:
            state["line_lost_start"] = (
                time.ticks_ms()
            )

        if elapsed_seconds(
            state["line_lost_start"]
        ) >= LINE_LOST_STOP_SECONDS:
            print("BLUE LINE LOST")

            enter_manual_mode()
            return

    else:
        state["line_lost_start"] = None

    error_change = (
        line_error
        - state["previous_line_error"]
    )

    correction = (
        LINE_KP * line_error
        + LINE_KD * error_change
    )

    correction = limit(
        correction,
        -LINE_MAX_CORRECTION,
        LINE_MAX_CORRECTION
    )

    left_power = (
        LINE_BASE_POWER
        - correction
    )

    right_power = (
        LINE_BASE_POWER
        + correction
    )

    # Do not allow either wheel to reverse.
    left_power = max(
        left_power,
        LINE_MIN_WHEEL_POWER
    )

    right_power = max(
        right_power,
        LINE_MIN_WHEEL_POWER
    )

    drivetrain.set_effort(
        limit(left_power),
        limit(right_power)
    )

    state["previous_line_error"] = line_error


# ============================================================
# D-PAD MODE BUTTONS
# ============================================================

def check_mode_buttons():
    current_up = pestolink.get_button(
        BUTTON_DPAD_UP
    )

    current_down = pestolink.get_button(
        BUTTON_DPAD_DOWN
    )

    current_left = pestolink.get_button(
        BUTTON_DPAD_LEFT
    )

    # D-pad Left cancels autonomy.
    if (
        current_left
        and not state["previous_left"]
    ):
        print("MANUAL OVERRIDE")

        enter_manual_mode()

    # D-pad Down starts maze autonomy.
    elif (
        current_down
        and not state["previous_down"]
    ):
        enter_maze_mode()

    # D-pad Up starts line autonomy.
    elif (
        current_up
        and not state["previous_up"]
    ):
        enter_line_mode()

    state["previous_up"] = current_up
    state["previous_down"] = current_down
    state["previous_left"] = current_left


# ============================================================
# STARTUP
# ============================================================

stop_drive()
stop_servo()

print("PROGRAM STARTED")
print("Waiting for PestoLink connection")


# ============================================================
# MAIN LOOP
# ============================================================

while True:
    try:
        if pestolink.is_connected():
            # Servo1 works in every robot mode.
            control_servo_one()

            # D-pad Left has highest priority.
            if dpad_left_pressed():
                if state["mode"] != MODE_MANUAL:
                    enter_manual_mode()

                manual_control()

                time.sleep(0.02)
                continue

            # RT, LT, or joystick cancels autonomy.
            if (
                state["mode"] != MODE_MANUAL
                and manual_drive_input_detected()
            ):
                enter_manual_mode()

            check_mode_buttons()

            if state["mode"] == MODE_MANUAL:
                manual_control()

            elif state["mode"] == MODE_MAZE:
                maze_control()

            elif state["mode"] == MODE_LINE:
                line_control()

            else:
                enter_manual_mode()

        else:
            stop_everything()

            state["mode"] = MODE_MANUAL
            state["maze_running"] = False

        time.sleep(0.02)

    except Exception as error:
        stop_everything()

        state["mode"] = MODE_MANUAL
        state["maze_running"] = False

        print("MAIN LOOP ERROR:")
        print(error)

        time.sleep(0.25)

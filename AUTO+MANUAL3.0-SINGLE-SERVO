from XRPLib.defaults import *
from pestolink import PestoLinkAgent
import time


# ============================================================
# PESTOLINK
# ============================================================

pestolink = PestoLinkAgent("OCHOBOTS")


# ============================================================
# CONTROLLER BUTTONS
# ============================================================

BUTTON_X = 2
BUTTON_Y = 3

BUTTON_LT = 6
BUTTON_RT = 7

RIGHT_STICK_X = 2


# ============================================================
# DRIVE SETTINGS
# ============================================================

DRIVE_POWER = 0.75
TURN_POWER = 0.60
JOYSTICK_DEADZONE = 0.12


# ============================================================
# SERVO SETTINGS
#
# This version only tests fixed servo positions.
# X = 180 degrees
# Y = 0 degrees
# ============================================================

SERVO_X_ANGLE = 180
SERVO_Y_ANGLE = 0


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def limit(value, minimum=-1.0, maximum=1.0):

    if value > maximum:
        return maximum

    if value < minimum:
        return minimum

    return value


def deadzone(value):

    if abs(value) < JOYSTICK_DEADZONE:
        return 0.0

    return value


def stop_robot():

    drivetrain.stop()


# ============================================================
# STARTUP
# ============================================================

stop_robot()

print("PROGRAM STARTED")
print("CONNECT TO OCHOBOTS IN PESTOLINK")


# ============================================================
# MAIN LOOP
# ============================================================

while True:

    try:

        if pestolink.is_connected():

            # -----------------------------------------------
            # FORWARD AND REVERSE
            # -----------------------------------------------

            if pestolink.get_button(BUTTON_RT):

                throttle = DRIVE_POWER

            elif pestolink.get_button(BUTTON_LT):

                throttle = -DRIVE_POWER

            else:

                throttle = 0.0


            # -----------------------------------------------
            # RIGHT-JOYSTICK STEERING
            # -----------------------------------------------

            steering = pestolink.get_axis(
                RIGHT_STICK_X
            )

            steering = deadzone(steering)

            steering = (
                steering
                * TURN_POWER
            )


            # -----------------------------------------------
            # MIX THROTTLE AND STEERING
            # -----------------------------------------------

            left_power = throttle + steering
            right_power = throttle - steering

            drivetrain.set_effort(
                limit(left_power),
                limit(right_power)
            )


            # -----------------------------------------------
            # SERVO TEST
            # -----------------------------------------------

            if pestolink.get_button(BUTTON_X):

                servo_one.set_angle(
                    SERVO_X_ANGLE
                )

            elif pestolink.get_button(BUTTON_Y):

                servo_one.set_angle(
                    SERVO_Y_ANGLE
                )

        else:

            stop_robot()

        time.sleep(0.02)


    except Exception as error:

        stop_robot()

        print("PROGRAM ERROR:")
        print(error)

        time.sleep(0.50)

from XRPLib.defaults import *
from pestolink import PestoLinkAgent
import time


# ==================================================
# PESTOLINK CONTROLLER
# ==================================================

pestolink = PestoLinkAgent("OCHOBOTS")


BUTTON_A = 0
BUTTON_B = 1
BUTTON_X = 2
BUTTON_Y = 3

BUTTON_LT = 6
BUTTON_RT = 7

# This still must be confirmed with your controller.
BUTTON_DPAD_LEFT = 14

RIGHT_STICK_X = 2


# ==================================================
# ROBOT MODES
# ==================================================

MODE_MANUAL = 0
MODE_MAZE = 1
MODE_LINE = 2


# ==================================================
# MANUAL DRIVE SETTINGS
# ==================================================

MANUAL_DRIVE_POWER = 0.90
MANUAL_TURN_POWER = 0.75

JOYSTICK_DEADZONE = 0.12


# ==================================================
# SERVO 1 WINCH SETTINGS
# ==================================================
#
# Standard positional servo:
#
# X = move winch to raised position
# B = move winch to lowered position
#
# This servo does not rotate continuously.
# ==================================================

SERVO1_LOWERED_ANGLE = 5
SERVO1_RAISED_ANGLE = 90


# ==================================================
# PREPROGRAMMED MAZE SETTINGS
# ==================================================

INCHES_TO_CM = 2.54

MAZE_DRIVE_EFFORT = 0.85
MAZE_TURN_EFFORT = 0.70


# If the robot turns the wrong direction during
# testing, swap these two signs.
LEFT_TURN_SIGN = -1
RIGHT_TURN_SIGN = 1


# Replace these example values with the real route.
#
# Available commands:
#
# ("forward", inches)
# ("reverse", inches)
# ("left", degrees)
# ("right", degrees)
#
# Long distances are split into shorter steps so
# the controller gets checked between movements.

MAZE_ROUTE = [
    ("forward", 12),
    ("forward", 12),

    ("right", 90),

    ("forward", 9),
    ("forward", 9),

    ("left", 90),

    ("forward", 10),
    ("forward", 10),
    ("forward", 10),

    ("right", 90),

    ("forward", 12)
]


# ==================================================
# BLUE-TAPE EDGE-FOLLOWING SETTINGS
# ==================================================
#
# IMPORTANT:
#
# The XRP reflectance sensors measure brightness.
# They do not identify the color blue directly.
#
# Replace these two values with readings measured
# from your actual floor and blue tape.
# ==================================================

FLOOR_READING = 0.75
BLUE_READING = 0.30


# The robot will follow the LEFT SIDE of the blue
# tape. The right sensor tracks the tape edge.
#
# The body of the robot should stay mostly beside
# the tape instead of directly over the tape.


# Target reading halfway between floor and blue.
BLUE_EDGE_TARGET = (
    FLOOR_READING + BLUE_READING
) / 2


# Start slowly while testing.
LINE_BASE_POWER = 0.30

# Proportional steering strength.
LINE_KP = 0.55

# Maximum allowed steering correction.
LINE_MAX_CORRECTION = 0.28

# Strong correction if the left sensor sees blue,
# meaning the robot crossed too far over the tape.
LINE_CROSSING_CORRECTION = 0.32

# Minimum difference required between floor and tape.
MIN_SENSOR_DIFFERENCE = 0.08

# Safety timeout before returning to manual mode.
LINE_MAX_TIME = 45.0


# ==================================================
# ROBOT STATE
# ==================================================

state = {
    "mode": MODE_MANUAL,

    "servo1_angle": SERVO1_LOWERED_ANGLE,

    "autonomy_start": time.ticks_ms(),

    "maze_step": 0,
    "maze_running": False,

    "previous_y_button": False,
    "previous_a_button": False,

    "previous_x_button": False,
    "previous_b_button": False
}


# ==================================================
# GENERAL HELPER FUNCTIONS
# ==================================================

def limit(value, minimum=-1.0, maximum=1.0):

    if value > maximum:
        return maximum

    if value < minimum:
        return minimum

    return value


def deadzone(value):

    if abs(value) < JOYSTICK_DEADZONE:
        return 0.0

    return value


def elapsed_seconds(start_time):

    elapsed_ms = time.ticks_diff(
        time.ticks_ms(),
        start_time
    )

    return elapsed_ms / 1000


def stop_drive():

    drivetrain.stop()


def stop_everything():

    stop_drive()

    # Hold the winch at its last selected position.
    servo_one.set_angle(
        state["servo1_angle"]
    )


# ==================================================
# MODE FUNCTIONS
# ==================================================

def enter_manual_mode():

    state["mode"] = MODE_MANUAL
    state["maze_running"] = False

    stop_everything()


def enter_maze_mode():

    stop_everything()

    state["mode"] = MODE_MAZE
    state["maze_step"] = 0
    state["maze_running"] = True


def enter_line_mode():

    stop_everything()

    state["mode"] = MODE_LINE
    state["autonomy_start"] = time.ticks_ms()


def autonomy_elapsed():

    return elapsed_seconds(
        state["autonomy_start"]
    )


# ==================================================
# SERVO 1 WINCH CONTROL
# ==================================================

def control_servo_one():

    current_x_button = pestolink.get_button(
        BUTTON_X
    )

    current_b_button = pestolink.get_button(
        BUTTON_B
    )


    # X was just pressed.
    if (
        current_x_button
        and not state["previous_x_button"]
    ):

        state["servo1_angle"] = (
            SERVO1_RAISED_ANGLE
        )

        servo_one.set_angle(
            state["servo1_angle"]
        )


    # B was just pressed.
    elif (
        current_b_button
        and not state["previous_b_button"]
    ):

        state["servo1_angle"] = (
            SERVO1_LOWERED_ANGLE
        )

        servo_one.set_angle(
            state["servo1_angle"]
        )


    state["previous_x_button"] = (
        current_x_button
    )

    state["previous_b_button"] = (
        current_b_button
    )


# ==================================================
# MANUAL DRIVE CONTROL
# ==================================================

def manual_control():

    # RT = forward
    if pestolink.get_button(BUTTON_RT):

        throttle = MANUAL_DRIVE_POWER


    # LT = reverse
    elif pestolink.get_button(BUTTON_LT):

        throttle = -MANUAL_DRIVE_POWER


    else:

        throttle = 0.0


    steering = pestolink.get_axis(
        RIGHT_STICK_X
    )

    steering = deadzone(steering)

    steering = (
        steering * MANUAL_TURN_POWER
    )


    left_power = throttle + steering
    right_power = throttle - steering


    drivetrain.set_effort(
        limit(left_power),
        limit(right_power)
    )


    control_servo_one()


# ==================================================
# PREPROGRAMMED MAZE FUNCTIONS
# ==================================================

def drive_forward_inches(distance_inches):

    distance_cm = (
        distance_inches * INCHES_TO_CM
    )

    drivetrain.straight(
        distance_cm,
        MAZE_DRIVE_EFFORT
    )


def drive_reverse_inches(distance_inches):

    distance_cm = (
        distance_inches * INCHES_TO_CM
    )

    drivetrain.straight(
        -distance_cm,
        MAZE_DRIVE_EFFORT
    )


def turn_left(degrees=90):

    turn_amount = (
        abs(degrees) * LEFT_TURN_SIGN
    )

    drivetrain.turn(
        turn_amount,
        MAZE_TURN_EFFORT
    )


def turn_right(degrees=90):

    turn_amount = (
        abs(degrees) * RIGHT_TURN_SIGN
    )

    drivetrain.turn(
        turn_amount,
        MAZE_TURN_EFFORT
    )


# ==================================================
# PREPROGRAMMED MAZE AUTONOMY
# ==================================================

def maze_control():

    # Servo is checked between route steps.
    control_servo_one()


    if not state["maze_running"]:

        enter_manual_mode()
        return


    # Finished every route instruction.
    if state["maze_step"] >= len(MAZE_ROUTE):

        state["maze_running"] = False

        stop_drive()

        enter_manual_mode()
        return


    instruction = MAZE_ROUTE[
        state["maze_step"]
    ]

    action = instruction[0]
    amount = instruction[1]


    if action == "forward":

        drive_forward_inches(amount)


    elif action == "reverse":

        drive_reverse_inches(amount)


    elif action == "left":

        turn_left(amount)


    elif action == "right":

        turn_right(amount)


    else:

        # Invalid route instruction.
        stop_drive()

        state["maze_running"] = False

        enter_manual_mode()
        return


    # Move to the next maze instruction.
    state["maze_step"] += 1


# ==================================================
# BLUE-TAPE SENSOR HELPERS
# ==================================================

def sensor_difference():

    return abs(
        FLOOR_READING - BLUE_READING
    )


def sensor_blue_amount(sensor_value):

    difference = (
        BLUE_READING - FLOOR_READING
    )


    # Prevent division by a very small number.
    if abs(difference) < MIN_SENSOR_DIFFERENCE:

        return 0.0


    # Approximately:
    #
    # 0 = floor
    # 1 = blue tape
    return (
        sensor_value - FLOOR_READING
    ) / difference


def left_sensor_has_crossed_blue(left_value):

    blue_amount = sensor_blue_amount(
        left_value
    )

    return blue_amount >= 0.65


# ==================================================
# BLUE-TAPE EDGE FOLLOWING
# ==================================================

def line_control():

    control_servo_one()


    # Safety timeout.
    if autonomy_elapsed() >= LINE_MAX_TIME:

        enter_manual_mode()
        return


    # Calibration safety check.
    if sensor_difference() < MIN_SENSOR_DIFFERENCE:

        stop_drive()
        enter_manual_mode()
        return


    left_value = reflectance.get_left()
    right_value = reflectance.get_right()


    # ------------------------------------------------
    # SAFETY CONDITION
    #
    # If the left sensor sees blue, the robot has
    # crossed too far over the tape.
    #
    # Turn sharply left to move back beside the tape.
    # ------------------------------------------------

    if left_sensor_has_crossed_blue(left_value):

        left_power = (
            LINE_BASE_POWER
            - LINE_CROSSING_CORRECTION
        )

        right_power = (
            LINE_BASE_POWER
            + LINE_CROSSING_CORRECTION
        )


        drivetrain.set_effort(
            limit(left_power),
            limit(right_power)
        )

        return


    # ------------------------------------------------
    # RIGHT-SENSOR EDGE FOLLOWING
    #
    # The right sensor should stay halfway between
    # the floor reading and blue-tape reading.
    # ------------------------------------------------

    difference = (
        BLUE_READING - FLOOR_READING
    )


    normalized_error = (
        right_value - BLUE_EDGE_TARGET
    ) / difference


    correction = (
        normalized_error * LINE_KP
    )


    correction = limit(
        correction,
        -LINE_MAX_CORRECTION,
        LINE_MAX_CORRECTION
    )


    # More blue than desired:
    # steer left, away from the tape.
    #
    # More floor than desired:
    # steer right, toward the tape.

    left_power = (
        LINE_BASE_POWER - correction
    )

    right_power = (
        LINE_BASE_POWER + correction
    )


    drivetrain.set_effort(
        limit(left_power),
        limit(right_power)
    )


# ==================================================
# MODE BUTTON CONTROL
# ==================================================

def check_mode_buttons():

    current_y_button = pestolink.get_button(
        BUTTON_Y
    )

    current_a_button = pestolink.get_button(
        BUTTON_A
    )


    # Y starts preprogrammed maze autonomy.
    if (
        current_y_button
        and not state["previous_y_button"]
    ):

        enter_maze_mode()


    # A starts blue-line edge following.
    if (
        current_a_button
        and not state["previous_a_button"]
    ):

        enter_line_mode()


    state["previous_y_button"] = (
        current_y_button
    )

    state["previous_a_button"] = (
        current_a_button
    )


# ==================================================
# MANUAL OVERRIDE
# ==================================================

def manual_override_pressed():

    return pestolink.get_button(
        BUTTON_DPAD_LEFT
    )


# ==================================================
# STARTUP
# ==================================================

# Put Servo 1 in its initial lowered position.
servo_one.set_angle(
    SERVO1_LOWERED_ANGLE
)


# ==================================================
# MAIN PROGRAM LOOP
# ==================================================

while True:

    if pestolink.is_connected():

        # D-pad left cancels autonomy.
        if manual_override_pressed():

            if state["mode"] != MODE_MANUAL:

                enter_manual_mode()


            manual_control()

            time.sleep(0.02)
            continue


        check_mode_buttons()


        if state["mode"] == MODE_MANUAL:

            manual_control()


        elif state["mode"] == MODE_MAZE:

            maze_control()


        elif state["mode"] == MODE_LINE:

            line_control()


        else:

            enter_manual_mode()


    else:

        stop_everything()

        state["mode"] = MODE_MANUAL
        state["maze_running"] = False


    time.sleep(0.02)

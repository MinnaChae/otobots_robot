# ============================================================
# XRP ROBOT - MANUAL CONTROL AND TWO AUTONOMY MODES
#
# MANUAL:
# RT              = Drive forward
# LT              = Drive backward
# Right joystick  = Steering
#
# SERVO 1:
# Tap X           = Raise Servo 1
# Tap B           = Lower Servo 1
#
# AUTONOMY:
# D-pad Down      = Start maze autonomy
# D-pad Up        = Start blue-line autonomy
# D-pad Left      = Stop autonomy and return to manual
#
# RT, LT, or right-stick movement also cancels autonomy.
# ============================================================

from XRPLib.defaults import *
from pestolink import PestoLinkAgent
import time


# ============================================================
# PESTOLINK CONNECTION
# ============================================================

pestolink = PestoLinkAgent("OCHOBOTS")


# ============================================================
# CONTROLLER BUTTON ASSIGNMENTS
# ============================================================

BUTTON_B = 1
BUTTON_X = 2

BUTTON_LT = 6
BUTTON_RT = 7

BUTTON_DPAD_UP = 12
BUTTON_DPAD_DOWN = 13
BUTTON_DPAD_LEFT = 14

RIGHT_STICK_X = 2


# ============================================================
# ROBOT MODES
# ============================================================

MODE_MANUAL = 0
MODE_MAZE = 1
MODE_LINE = 2


# ============================================================
# MANUAL DRIVE SETTINGS
# ============================================================

MANUAL_DRIVE_POWER = 0.85
MANUAL_TURN_POWER = 0.65

JOYSTICK_DEADZONE = 0.12


# ============================================================
# SERVO 1 SETTINGS
# ============================================================

SERVO1_LOWERED_ANGLE = 5
SERVO1_RAISED_ANGLE = 90


# ============================================================
# MAZE SETTINGS
# ============================================================

INCHES_TO_CM = 2.54

# The installed wheels are approximately 1/3 smaller than the
# wheels expected by the default drivetrain calibration.
#
# A wheel that is 1/3 smaller is approximately 2/3 the original
# diameter, so distance commands are multiplied by 1.5.
MAZE_WHEEL_DISTANCE_SCALE = 1.50

# Slightly higher power for the smaller wheels.
MAZE_DRIVE_POWER = 0.92
MAZE_TURN_POWER = 0.75

# Start at 1.00.
#
# Increase this if the robot turns less than 90 degrees.
# Decrease this if the robot turns more than 90 degrees.
MAZE_TURN_SCALE = 1.00

# Reverse these signs if left and right are backward.
LEFT_TURN_SIGN = -1
RIGHT_TURN_SIGN = 1

MAZE_STEP_PAUSE = 0.10

# Straight movements are divided into small sections so D-pad
# Left can be checked between sections.
MAZE_DISTANCE_CHUNK_INCHES = 2.0


# ============================================================
# NEWEST MAZE ROUTE
#
# All straight distances are in inches.
# All turns are 90 degrees.
# ============================================================

MAZE_ROUTE = [

    ("forward", 25),
    ("right", 90),

    ("forward", 9),
    ("right", 90),

    ("forward", 22),
    ("left", 90),

    ("forward", 15),
    ("left", 90),

    ("forward", 14),
    ("left", 90),

    ("forward", 9),
    ("right", 90),

    ("forward", 12),
    ("right", 90),

    ("forward", 10),
    ("left", 90),

    ("forward", 11),
    ("left", 90),

    ("forward", 8),
    ("right", 90),

    ("forward", 9),
    ("left", 90),

    ("forward", 8),
    ("left", 90),

    ("forward", 10),
    ("right", 90),

    ("forward", 8),
    ("right", 90),

    ("forward", 19)

]


# ============================================================
# BLUE-LINE SETTINGS
#
# Calibrate these readings on the actual black floor and blue
# line before the competition.
# ============================================================

BLACK_FLOOR_READING = 0.10
BLUE_LINE_READING = 0.35

# Forward line-following speed.
LINE_BASE_POWER = 0.27

# Neither wheel is allowed below this power.
# This prevents pivot turns and wheel reversal.
LINE_MIN_FORWARD_POWER = 0.14

# Gentle proportional steering.
LINE_KP = 0.32
LINE_MAX_CORRECTION = 0.14

# Gentle correction when both sensors briefly lose the line.
LINE_SEARCH_CORRECTION = 0.09

# Smooth sudden sensor changes.
LINE_CORRECTION_SMOOTHING = 0.25

MIN_CALIBRATION_DIFFERENCE = 0.05

# Maximum time line autonomy can operate.
LINE_MAX_TIME_SECONDS = 45.0


# ============================================================
# ROBOT STATE
# ============================================================

state = {

    "mode": MODE_MANUAL,

    "servo1_angle": SERVO1_LOWERED_ANGLE,

    "maze_step": 0,
    "maze_running": False,

    "line_start_time": time.ticks_ms(),

    "last_line_direction": 1,
    "line_correction": 0.0,

    "previous_dpad_up": False,
    "previous_dpad_down": False,
    "previous_dpad_left": False,

    "previous_x": False,
    "previous_b": False

}


# ============================================================
# GENERAL FUNCTIONS
# ============================================================

def limit(value, minimum=-1.0, maximum=1.0):
    """Keep a value between the selected minimum and maximum."""

    if value > maximum:
        return maximum

    if value < minimum:
        return minimum

    return value


def apply_deadzone(value):
    """Ignore small accidental joystick movements."""

    if abs(value) < JOYSTICK_DEADZONE:
        return 0.0

    return value


def elapsed_seconds(start_time):
    """Return elapsed time in seconds."""

    elapsed_ms = time.ticks_diff(
        time.ticks_ms(),
        start_time
    )

    return elapsed_ms / 1000.0


def stop_drive():
    """Stop both drive motors."""

    drivetrain.stop()


def hold_servo_position():
    """Keep Servo 1 at its saved angle."""

    servo_one.set_angle(
        state["servo1_angle"]
    )


def stop_everything():
    """Stop the drivetrain and hold the servo position."""

    stop_drive()
    hold_servo_position()


# ============================================================
# MODE FUNCTIONS
# ============================================================

def enter_manual_mode():
    print("MODE -> MANUAL")
    """Stop autonomy and return to manual control."""

    stop_drive()

    state["mode"] = MODE_MANUAL
    state["maze_running"] = False
    state["line_correction"] = 0.0


def enter_maze_mode():
    print("MODE -> MAZE")
    """Start the maze route from the beginning."""

    stop_drive()

    state["mode"] = MODE_MAZE
    state["maze_step"] = 0
    state["maze_running"] = True


def enter_line_mode():
    print("MODE -> LINE FOLLOW")
    """Start blue-line-following autonomy."""

    stop_drive()

    state["mode"] = MODE_LINE
    state["line_start_time"] = time.ticks_ms()
    state["last_line_direction"] = 1
    state["line_correction"] = 0.0


# ============================================================
# SERVO 1 CONTROL
# ============================================================

def control_servo_one():
    """
    Tap X to raise Servo 1.

    Tap B to lower Servo 1.

    The servo remains at the selected position after the button
    is released.
    """

    current_x = pestolink.get_button(BUTTON_X)
    current_b = pestolink.get_button(BUTTON_B)

    if current_x and not state["previous_x"]:

        state["servo1_angle"] = SERVO1_RAISED_ANGLE

        servo_one.set_angle(
            state["servo1_angle"]
        )
        print("Servo raised")

    elif current_b and not state["previous_b"]:

        state["servo1_angle"] = SERVO1_LOWERED_ANGLE

        servo_one.set_angle(
            state["servo1_angle"]
        )
        print("Servo lowered")

    state["previous_x"] = current_x
    state["previous_b"] = current_b


# ============================================================
# MANUAL OVERRIDE
# ============================================================

def dpad_left_pressed():
    """Return True while D-pad Left is being pressed."""

    return pestolink.get_button(
        BUTTON_DPAD_LEFT
    )


def manual_input_detected():
    """
    RT, LT, or right-stick movement cancels autonomy.
    """

    if pestolink.get_button(BUTTON_RT):
        return True

    if pestolink.get_button(BUTTON_LT):
        return True

    steering = pestolink.get_axis(
        RIGHT_STICK_X
    )

    steering = apply_deadzone(steering)

    if steering != 0.0:
        return True

    return False


# ============================================================
# MANUAL DRIVING
# ============================================================

def manual_control():
    """
    RT drives forward.

    LT drives backward.

    The right joystick controls steering.
    """

    throttle = 0.0

    if pestolink.get_button(BUTTON_RT):

        throttle = MANUAL_DRIVE_POWER

    elif pestolink.get_button(BUTTON_LT):

        throttle = -MANUAL_DRIVE_POWER

    steering = pestolink.get_axis(
        RIGHT_STICK_X
    )

    steering = apply_deadzone(steering)
    steering = steering * MANUAL_TURN_POWER

    left_power = throttle + steering
    right_power = throttle - steering

    drivetrain.set_effort(
        limit(left_power),
        limit(right_power)
    )


# ============================================================
# MAZE MOVEMENT
# ============================================================

def drive_distance_in_chunks(
    distance_inches,
    direction_sign
):
    """
    Drive an encoder-measured maze distance.

    The requested distance is multiplied by 1.5 to compensate
    for the wheels being approximately one-third smaller.

    The route itself stays written using the actual measured
    maze distances.
    """

    remaining_inches = abs(distance_inches)

    while remaining_inches > 0.0:

        if dpad_left_pressed():

            enter_manual_mode()
            return False

        chunk_inches = min(
            remaining_inches,
            MAZE_DISTANCE_CHUNK_INCHES
        )

        adjusted_chunk_inches = (
            chunk_inches
            * MAZE_WHEEL_DISTANCE_SCALE
        )

        adjusted_chunk_cm = (
            adjusted_chunk_inches
            * INCHES_TO_CM
            * direction_sign
        )

        drivetrain.straight(
            adjusted_chunk_cm,
            MAZE_DRIVE_POWER
        )

        remaining_inches -= chunk_inches

    return True


def drive_forward_inches(distance_inches):
    """Drive forward by the selected number of inches."""

    return drive_distance_in_chunks(
        distance_inches,
        1
    )


def drive_reverse_inches(distance_inches):
    """Drive backward by the selected number of inches."""

    return drive_distance_in_chunks(
        distance_inches,
        -1
    )


def turn_left(degrees):
    """Turn left by the selected number of degrees."""

    if dpad_left_pressed():

        enter_manual_mode()
        return False

    adjusted_degrees = (
        abs(degrees)
        * MAZE_TURN_SCALE
    )

    turn_amount = (
        adjusted_degrees
        * LEFT_TURN_SIGN
    )

    drivetrain.turn(
        turn_amount,
        MAZE_TURN_POWER
    )

    return True


def turn_right(degrees):
    """Turn right by the selected number of degrees."""

    if dpad_left_pressed():

        enter_manual_mode()
        return False

    adjusted_degrees = (
        abs(degrees)
        * MAZE_TURN_SCALE
    )

    turn_amount = (
        adjusted_degrees
        * RIGHT_TURN_SIGN
    )

    drivetrain.turn(
        turn_amount,
        MAZE_TURN_POWER
    )

    return True


def perform_maze_instruction(action, amount):
    """Perform one maze-route instruction."""

    if action == "forward":

        return drive_forward_inches(amount)

    elif action == "reverse":

        return drive_reverse_inches(amount)

    elif action == "left":

        return turn_left(amount)

    elif action == "right":

        return turn_right(amount)

    elif action == "wait":

        stop_drive()

        wait_start = time.ticks_ms()

        while elapsed_seconds(wait_start) < amount:

            if dpad_left_pressed():

                enter_manual_mode()
                return False

            time.sleep(0.02)

        return True

    return False


# ============================================================
# MAZE AUTONOMY
# ============================================================

def maze_control():
    """Run the newest programmed maze route."""

    if not state["maze_running"]:

        enter_manual_mode()
        return

    if dpad_left_pressed():

        enter_manual_mode()
        return

    # The entire route is finished.
    if state["maze_step"] >= len(MAZE_ROUTE):

        stop_drive()

        state["maze_running"] = False
        state["mode"] = MODE_MANUAL

        return

    print(f"Maze step {state['maze_step']+1}/{len(MAZE_ROUTE)}")
    instruction = MAZE_ROUTE[
        state["maze_step"]
    ]

    action = instruction[0]
    amount = instruction[1]

    valid_instruction = perform_maze_instruction(
        action,
        amount
    )

    if not valid_instruction:

        stop_drive()

        state["maze_running"] = False
        state["mode"] = MODE_MANUAL

        return

    state["maze_step"] += 1

    stop_drive()
    time.sleep(MAZE_STEP_PAUSE)


# ============================================================
# BLUE-LINE SENSOR FUNCTIONS
# ============================================================

def calibration_difference():
    """Return the difference between the calibration readings."""

    return abs(
        BLUE_LINE_READING
        - BLACK_FLOOR_READING
    )


def blue_strength(sensor_value):
    """
    Convert a reflectance reading into an estimated amount of blue.

    0.0 means the sensor sees the black floor.

    1.0 means the sensor sees the blue line.
    """

    difference = (
        BLUE_LINE_READING
        - BLACK_FLOOR_READING
    )

    if abs(difference) < MIN_CALIBRATION_DIFFERENCE:

        return 0.0

    strength = (
        sensor_value
        - BLACK_FLOOR_READING
    ) / difference

    return limit(
        strength,
        0.0,
        1.0
    )


# ============================================================
# BLUE-LINE AUTONOMY
# ============================================================

def line_control():
    """
    Follow the blue line with small, smooth corrections.

    Both wheels remain moving forward.

    The robot does not use pivot turns while line following.
    """

    if dpad_left_pressed():

        enter_manual_mode()
        return

    line_elapsed = elapsed_seconds(
        state["line_start_time"]
    )

    if line_elapsed >= LINE_MAX_TIME_SECONDS:

        enter_manual_mode()
        return

    if (
        calibration_difference()
        < MIN_CALIBRATION_DIFFERENCE
    ):

        stop_drive()
        enter_manual_mode()

        return

    left_value = reflectance.get_left()
    print(f"Reflectance L={left_value:.3f}")
    right_value = reflectance.get_right()
    print(f"Reflectance R={right_value:.3f}")

    left_blue = blue_strength(left_value)
    right_blue = blue_strength(right_value)

    # Record which sensor most recently saw more of the line.
    if left_blue > right_blue + 0.05:

        state["last_line_direction"] = -1

    elif right_blue > left_blue + 0.05:

        state["last_line_direction"] = 1

    # At least one sensor sees the blue line.
    if (
        left_blue >= 0.20
        or right_blue >= 0.20
    ):

        line_error = (
            left_blue
            - right_blue
        )

        target_correction = limit(
            line_error * LINE_KP,
            -LINE_MAX_CORRECTION,
            LINE_MAX_CORRECTION
        )

    # Both sensors temporarily lost the line.
    else:

        target_correction = (
            state["last_line_direction"]
            * LINE_SEARCH_CORRECTION
        )

    # Smooth the steering correction.
    state["line_correction"] += (
        target_correction
        - state["line_correction"]
    ) * LINE_CORRECTION_SMOOTHING

    correction = state["line_correction"]

    left_power = (
        LINE_BASE_POWER
        - correction
    )

    right_power = (
        LINE_BASE_POWER
        + correction
    )

    # Both wheels always remain forward.
    left_power = limit(
        left_power,
        LINE_MIN_FORWARD_POWER,
        1.0
    )

    right_power = limit(
        right_power,
        LINE_MIN_FORWARD_POWER,
        1.0
    )

    print(f"Line drive L={left_power:.2f} R={right_power:.2f}")
    drivetrain.set_effort(
        left_power,
        right_power
    )


# ============================================================
# D-PAD MODE BUTTONS
# ============================================================

def check_mode_buttons():
    """
    D-pad Left returns to manual mode.

    D-pad Down starts maze autonomy.

    D-pad Up starts blue-line autonomy.
    """

    current_dpad_left = pestolink.get_button(
        BUTTON_DPAD_LEFT
    )

    current_dpad_up = pestolink.get_button(
        BUTTON_DPAD_UP
    )

    current_dpad_down = pestolink.get_button(
        BUTTON_DPAD_DOWN
    )

    # D-pad Left has priority.
    if (
        current_dpad_left
        and not state["previous_dpad_left"]
    ):

        enter_manual_mode()

    elif (
        current_dpad_down
        and not state["previous_dpad_down"]
    ):

        enter_maze_mode()

    elif (
        current_dpad_up
        and not state["previous_dpad_up"]
    ):

        enter_line_mode()

    state["previous_dpad_left"] = current_dpad_left
    state["previous_dpad_up"] = current_dpad_up
    state["previous_dpad_down"] = current_dpad_down


# ============================================================
# STARTUP
# ============================================================

stop_drive()

state["servo1_angle"] = SERVO1_LOWERED_ANGLE

servo_one.set_angle(
    state["servo1_angle"]
)


# ============================================================
# MAIN PROGRAM LOOP
# ============================================================

while True:

    try:

        if pestolink.is_connected():

            print(f"Current mode: {state['mode']}")

            # Servo buttons work in every mode.
            control_servo_one()

            # Check D-pad mode buttons.
            check_mode_buttons()

            # Manual driving input cancels autonomy.
            if (
                state["mode"] != MODE_MANUAL
                and manual_input_detected()
            ):

                enter_manual_mode()

            if state["mode"] == MODE_MANUAL:

                manual_control()

            elif state["mode"] == MODE_MAZE:

                maze_control()

            elif state["mode"] == MODE_LINE:

                line_control()

            else:

                enter_manual_mode()

        else:

            stop_everything()

            state["mode"] = MODE_MANUAL
            state["maze_running"] = False

        time.sleep(0.02)

    except Exception as error:

        stop_everything()

        state["mode"] = MODE_MANUAL
        state["maze_running"] = False

        print("PROGRAM ERROR:")
        print(error)
        print("Robot returned to MANUAL after error")

        time.sleep(0.50)

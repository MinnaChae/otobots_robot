#
# If the robot travels 3% too far:
# DISTANCE_SCALE = 0.97
#
# If it travels 3% too short:
# DISTANCE_SCALE = 1.03
DISTANCE_SCALE = 1.00

# Optional amount removed from every maze straightaway.
DISTANCE_TRIM_INCHES = 0.0

# Smaller chunks create more frequent safety checks.
MAZE_CHUNK_CM = 2.0

MAZE_STRAIGHT_TIMEOUT = 4.0
MAZE_TURN_TIMEOUT = 4.0

MAZE_STRAIGHT_PAUSE = 0.05
MAZE_TURN_PAUSE = 0.20


# ============================================================
#               BLUE-LINE FOLLOWER SETTINGS
# ============================================================

LINE_BASE_SPEED = 0.26
LINE_MIN_SPEED = 0.12
LINE_MAX_EFFORT = 0.48

# Steering response.
LINE_KP = 0.75
LINE_KD = 0.18

LINE_LOOP_DELAY = 0.012

# Change this to True if the robot corrects away from the tape.
REVERSE_LINE_STEERING = False

# Change this if the sensor values are opposite of expectations.
INVERT_LINE_READINGS = False

# Minimum difference between left and right sensor readings.
LINE_MIN_DIFFERENCE = 0.025


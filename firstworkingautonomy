# Front range-sensor safety distance.
FRONT_STOP_DISTANCE_CM = 10.0

INVALID_DISTANCE_CM = 65535


# ============================================================
#                     MAZE SETTINGS
# ============================================================

INCHES_TO_CM = 2.54


# ============================================================
# XRP AUTONOMOUS SQUIGGLY-LINE FOLLOWER
#
# IR sensors:
#   - Follow a blue line on a light-colored floor
#
# Ultrasonic sensor:
#   - Stop when an object is too close
#
# This program does NOT need the controller to drive.
# The robot drives itself after it powers on.
# ============================================================

from XRPLib.defaults import *
import time


# ------------------------------------------------------------
# SETTINGS YOU MAY NEED TO ADJUST
# ------------------------------------------------------------

# Normal forward motor power
BASE_SPEED = 0.32

# Maximum motor power during a sharp correction
MAX_SPEED = 0.62

# How strongly the robot corrects itself
# Increase this if the robot does not turn enough.
# Decrease this if the robot shakes left and right.
KP = 0.85

# Small amount of smoothing
# Increase slightly if the robot is very shaky.
KD = 0.10

# Robot stops when an obstacle is this close
STOP_DISTANCE_CM = 18

# Ignore impossible or bad ultrasonic readings
MIN_VALID_DISTANCE_CM = 2
MAX_VALID_DISTANCE_CM = 400

# How long the robot waits between sensor readings
LOOP_DELAY = 0.01

# How long it searches after completely losing the line
LINE_LOST_TIMEOUT = 3.0


# ------------------------------------------------------------
# HELPER FUNCTION
# Keeps motor power between -1.0 and 1.0
# ------------------------------------------------------------

def limit(value, minimum, maximum):
    if value > maximum:
        return maximum

    if value < minimum:
        return minimum

    return value


# ------------------------------------------------------------
# SAFE STOP
# ------------------------------------------------------------

def stop_robot():
    drivetrain.stop()


# ------------------------------------------------------------
# ULTRASONIC SENSOR CHECK
# ------------------------------------------------------------

def obstacle_is_close():
    distance = rangefinder.distance()

    # Only trust the reading if it is within a reasonable range
    if MIN_VALID_DISTANCE_CM <= distance <= MAX_VALID_DISTANCE_CM:
        if distance <= STOP_DISTANCE_CM:
            return True

    return False


# ------------------------------------------------------------
# MAIN AUTONOMOUS PROGRAM
# ------------------------------------------------------------

def autonomous_line_follow():

    previous_error = 0.0
    last_seen_direction = 1

    line_lost_start = None

    # Give the robot time to finish starting
    stop_robot()
    time.sleep(2)

    while True:

        # ----------------------------------------------------
        # 1. CHECK FOR AN OBSTACLE
        # ----------------------------------------------------

        if obstacle_is_close():
            stop_robot()

            # Stay stopped until the obstacle is removed
            while obstacle_is_close():
                stop_robot()
                time.sleep(0.05)

            # Small pause before moving again
            time.sleep(0.30)

        # ----------------------------------------------------
        # 2. READ THE TWO IR LINE SENSORS
        #
        # Around 0 = white
        # Around 1 = blue
        # ----------------------------------------------------

        left_ir = reflectance.get_left()
        right_ir = reflectance.get_right()

        # ----------------------------------------------------
        # 3. FIND THE ROBOT'S POSITION OVER THE LINE
        #
        # If left sees more blue:
        # error becomes positive.
        #
        # If right sees more blue:
        # error becomes negative.
        # ----------------------------------------------------

        error = left_ir - right_ir

        # Remember which side last saw the line
        if error > 0.03:
            last_seen_direction = 1

        elif error < -0.03:
            last_seen_direction = -1

        # ----------------------------------------------------
        # 4. DETECT WHEN BOTH SENSORS LOST THE LINE
        #
        # These values assume blue gives a larger reading.
        # ----------------------------------------------------

        line_visible = left_ir > 0.12 or right_ir > 0.12

        if line_visible:
            line_lost_start = None

        else:
            if line_lost_start is None:
                line_lost_start = time.ticks_ms()

            lost_time_ms = time.ticks_diff(
                time.ticks_ms(),
                line_lost_start
            )

            # Stop completely if the line cannot be found
            # after several seconds.
            if lost_time_ms > LINE_LOST_TIMEOUT * 1000:
                stop_robot()
                break

            # Search in the direction where the line was
            # last detected.
            if last_seen_direction > 0:
                drivetrain.set_effort(-0.18, 0.30)
            else:
                drivetrain.set_effort(0.30, -0.18)

            time.sleep(LOOP_DELAY)
            continue

        # ----------------------------------------------------
        # 5. PD STEERING CONTROL
        #
        # P = reacts to current position error
        # D = slows down rapid side-to-side movement
        # ----------------------------------------------------

        change_in_error = error - previous_error

        steering = (
            KP * error
            + KD * change_in_error
        )

        previous_error = error

        # Slow down slightly during sharp turns
        sharpness = abs(error)

        forward_speed = BASE_SPEED - (sharpness * 0.10)

        if forward_speed < 0.18:
            forward_speed = 0.18

        # Positive steering turns the XRP left.
        left_power = forward_speed - steering
        right_power = forward_speed + steering

        left_power = limit(
            left_power,
            -MAX_SPEED,
            MAX_SPEED
        )

        right_power = limit(
            right_power,
            -MAX_SPEED,
            MAX_SPEED
        )

        # ----------------------------------------------------
        # 6. DRIVE THE ROBOT
        # ----------------------------------------------------

        drivetrain.set_effort(
            left_power,
            right_power
        )

        time.sleep(LOOP_DELAY)


# ------------------------------------------------------------
# START THE PROGRAM
# ------------------------------------------------------------

try:
    autonomous_line_follow()

except KeyboardInterrupt:
    stop_robot()

except Exception as error:
    stop_robot()
    print("Robot stopped because of an error:")
    print(error)

finally:
    stop_robot()



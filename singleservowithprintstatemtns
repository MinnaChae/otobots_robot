# Sensor 2 = Front distance sensor
# ============================================================

from XRPLib.defaults import *
from pestolink import PestoLinkAgent
import time


# ============================================================
# PESTOLINK
# ============================================================

pestolink = PestoLinkAgent("OCHOBOTS")


# ============================================================
# CONTROLLER BUTTONS
# ============================================================

BUTTON_B = 1
BUTTON_X = 2

BUTTON_LT = 6
BUTTON_RT = 7

BUTTON_DPAD_UP = 12
BUTTON_DPAD_DOWN = 13
BUTTON_DPAD_LEFT = 14

RIGHT_STICK_X = 2


# ============================================================
# ROBOT MODES
# ============================================================

MODE_MANUAL = 0
MODE_MAZE = 1
MODE_LINE = 2


# ============================================================
# STATUS PRINTING
# ============================================================

PRINT_DEBUG_BUTTONS = True
PRINT_EACH_MAZE_STEP = True

MODE_NAMES = {
    MODE_MANUAL: "MANUAL",
    MODE_MAZE: "MAZE",
    MODE_LINE: "BLUE LINE",
}


